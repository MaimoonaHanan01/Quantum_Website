---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  is_starred: boolean;
  cellIndex?: number;
}
const { logo, title, is_starred, cellIndex = 0 } = Astro.props;

const cellBadges = [
  "400-Row Stream",
  "Composite Key",
  "Effective-Dated",
  "$0.00 Variance",
  "5-Tab XLSX",
  "PACT Dispatch",
  "AES-256 + TOTP",
  "Sub-15ms P99",
  "Audit Lineage",
];
const badgeText = cellBadges[cellIndex] ?? "Verified";
---

<div
  class={`group q-feature-cell p-8 xl:px-10 xl:py-10 border-t border-l border-border/60 relative transition-all duration-300 ${is_starred ? "clay-feature-wave rounded-2xl shadow-md" : ""}`}
  data-feature-cell={cellIndex}
>
  <div class="flex items-center justify-between mb-5">
    <span class="px-3 py-1 rounded-full text-[11px] font-bold tracking-wide uppercase bg-white/85 text-primary border border-primary/20 shadow-2xs">
      {badgeText}
    </span>
    <span class="text-xs font-extrabold text-primary/55">
      0{cellIndex + 1}
    </span>
  </div>
  <div class="q-cell-icon size-13 rounded-2xl bg-white/85 grid place-items-center mb-5 mx-auto shadow-sm transition-all duration-300 group-hover:scale-115 group-hover:-rotate-6 group-hover:bg-white group-hover:shadow-md">
    <ImageMod src={logo} alt={`${title} icon`} class="size-6 transition-transform duration-300 group-hover:scale-110" />
  </div>
  <h3 class="text-h5-sm font-bold mb-2 text-center text-dark transition-colors duration-200 group-hover:text-primary">
    {title}
  </h3>
  <p class="text-center text-text-dark text-sm">
    Automated calculation, reconciliation, and audit-ready schedules.
  </p>
  <div class="w-16 h-1 bg-primary/15 rounded-full mx-auto mt-5 overflow-hidden">
    <div
      class="q-cell-bar h-full rounded-full"
      style="width: 0%; background: linear-gradient(90deg, #5d8a77, #4c7889);"
    />
  </div>
</div>
