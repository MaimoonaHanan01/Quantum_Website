---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  is_starred: boolean;
}
const { logo, title, is_starred } = Astro.props;
---

<div
  class={`p-8 xl:px-10 xl:py-11 border-t border-l border-border/60 relative transition-all duration-200 ${is_starred ? "clay-feature-wave rounded-2xl" : "hover:bg-white/40"}`}
>
  <div class="size-12 rounded-2xl bg-white/80 grid place-items-center mb-5 mx-auto shadow-sm">
    <ImageMod src={logo} alt={`${title} icon`} class="size-6" />
  </div>
  <h3 class="text-h5-sm font-bold mb-2 text-center text-dark">{title}</h3>
  <p class="text-center text-text-dark text-sm">
    Automated calculation, reconciliation, and audit-ready schedules.
  </p>
  {
    [
      "top-0 left-0 -translate-x-1/2 -translate-y-1/2",
      "top-0 right-0 translate-x-1/2 -translate-y-1/2",
      "bottom-0 left-0 -translate-x-1/2 translate-y-1/2",
      "bottom-0 right-0 translate-x-1/2 translate-y-1/2",
    ].map((pos) => (
      <svg
        data-is-starred={String(is_starred)}
        class={`absolute z-10 ${pos} hidden`}
        width="23"
        height="23"
        viewBox="0 0 23 23"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          opacity="0.7"
          d="M11.5 0C11.5 0 11.3776 6.44974 13.9639 9.03606C16.5503 11.6224 23 11.5 23 11.5C23 11.5 16.5503 11.3776 13.9639 13.9639C11.3776 16.5503 11.5 23 11.5 23C11.5 23 11.6224 16.5503 9.03606 13.9639C6.44974 11.3776 0 11.5 0 11.5C0 11.5 6.44974 11.6224 9.03606 9.03606C11.6224 6.44974 11.5 0 11.5 0Z"
          fill="var(--color-primary)"
        />
      </svg>
    ))
  }
</div>
