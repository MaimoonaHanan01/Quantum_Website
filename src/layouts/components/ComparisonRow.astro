---
import { getListPage } from "@/lib/contentParser.astro";
import type { ComparisonRowSection } from "@/types";

const comparisonEntry = await getListPage(
  "comparisonRowSection",
  "comparison-row",
);
const comparisonData: ComparisonRowSection = comparisonEntry.data;
if (!comparisonData.enable) return;

const stateSchedules = [
  ["State Return", "Vapor Excise", "County Schedule", "5-Tab XLSX"],
  ["State ST-3", "L-2075 Volume", "Local Option", "5-Tab XLSX"],
  ["CDTFA-401", "CECET 12.5%", "District Tax", "5-Tab XLSX"],
  ["Form ST-50", "VPT-10 Split", "mL + Retail %", "5-Tab XLSX"],
  ["Form ST-1", "TP-1 Wholesale", "Destination Rate", "5-Tab XLSX"],
  ["Form ST-36", "EC-2 Receipts", "Distributor Inv", "5-Tab XLSX"],
];
---

{
  comparisonData.enable && (
    <section class="section relative isolate overflow-x-hidden">
      <div class="container">
        <div class="section-container">
          <div class="section-intro centralize">
            <h2 class="title hasHighlight" set:html={comparisonData.title} />
          </div>
          <div class="section-content">
            <div class="flex flex-col gap-y-5 px-4">
              {comparisonData.items.map(({ title, price }, idx) => (
                <div class="relative max-lg:border max-lg:border-border max-lg:rounded-3xl max-lg:py-6">
                  <div class="flex items-center flex-col lg:flex-row lg:justify-between w-full gap-y-6">
                    <div class="clay-card px-6 w-full py-3.5 rounded-full flex items-center justify-center relative z-10 gap-x-2 max-w-80">
                      <span class="font-bold text-dark text-base">
                        {title}
                      </span>
                    </div>

                    <div class="flex items-center justify-center flex-wrap gap-2.5 xl:gap-3 lg:min-w-95 relative z-10">
                      {(stateSchedules[idx] ?? stateSchedules[0]).map((tag) => (
                        <span class="px-4 py-2 rounded-full bg-[#faf6f1] border border-white/90 text-xs font-semibold text-dark shadow-sm">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <div class="clay-card px-6 w-full py-3.5 rounded-full flex items-center justify-center relative z-10 gap-x-2 max-w-64">
                      <span class="font-medium text-text text-sm">
                        <span class="text-primary font-secondary font-bold text-h6">
                          {price}
                        </span>{" "}
                        {comparisonData.price_suffix ?? "Basis"}
                      </span>
                    </div>
                  </div>

                  <div class="absolute inset-0 items-center -z-10 hidden xl:flex">
                    <div class="border-t border-border border-dashed w-full" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
