---
import { markdownify } from "@/lib/utils/textConverter";

interface Props {
  lead_generation: any;
}

const { lead_generation } = Astro.props;

const workbookTabs = [
  {
    id: "01",
    tab: "Tab 1: Guide",
    state: "WA — Form REV 81-1012",
    rows: [
      { k: "Portal Frequency", v: "Monthly (Due 25th)" },
      { k: "Excise Basis", v: "95% Wholesale + $0.09/mL" },
      { k: "Filing Status", v: "Ready for Portal Entry" },
    ],
  },
  {
    id: "02",
    tab: "Tab 2: Summary",
    state: "Line-by-Line Return",
    rows: [
      { k: "Gross State Sales", v: "$142,850.00" },
      { k: "Exempt / Wholesale", v: "$18,400.00" },
      { k: "Net Taxable + Excise", v: "$124,450.00" },
    ],
  },
  {
    id: "03",
    tab: "Tab 3: Counties",
    state: "Locality Code Schedule",
    rows: [
      { k: "1726 — King County", v: "$54,120.00 · 10.25%" },
      { k: "2717 — Pierce County", v: "$28,640.00 · 9.40%" },
      { k: "3115 — Snohomish", v: "$19,880.00 · 9.20%" },
    ],
  },
  {
    id: "04",
    tab: "Tab 4: Reconcile",
    state: "Collected vs Computed",
    rows: [
      { k: "Tax Collected (Store)", v: "$12,844.10" },
      { k: "Tax Computed (ExciseR.com)", v: "$12,844.10" },
      { k: "Reconciliation Delta", v: "$0.00 Variance" },
    ],
  },
  {
    id: "05",
    tab: "Tab 5: Audit",
    state: "Deterministic Lineage",
    rows: [
      { k: "SKU Catalog Coverage", v: "2,440 / 2,440 Verified" },
      { k: "Effective Rule Version", v: "2026-Q4-REV3" },
      { k: "Dedupe Composite Key", v: "DocID · LineNo · SKU" },
    ],
  },
];
---

<section class="section-box bg-transparent my-0 pb-0 shadow-none border-0">
  <div class="container-sm">
    <div class="section-container pb-20">
      <div class="section-intro centralize">
        <h2
          class="title hasHighlight"
          set:html={lead_generation.title}
        />
      </div>
      <div class="section-content">
        <div class="flex flex-col-reverse lg:flex-row gap-x-16 gap-y-12 items-center">
          <div class="lg:w-6/12">
            <h3 class="text-h5-sm font-bold mb-6 text-dark">
              {lead_generation.subtitle}
            </h3>
            <div
              class="space-y-4 text-text"
              set:html={markdownify(lead_generation.content, true)}
            />
            <ul class="green-tick-list [&>li]:mb-6 mt-8 text-dark font-medium">
              {lead_generation.list.map((item: string) => (
                <li set:html={markdownify(item)} />
              ))}
            </ul>
          </div>
          <div class="lg:w-6/12 w-full">
            <div class="q-layered-stack clay-card rounded-[32px] p-7 xl:p-9 mt-6" data-workbook-widget>
              <!-- Interactive 5-Tab Switcher Deck -->
              <div class="flex flex-wrap gap-1.5 mb-5">
                {workbookTabs.map((t, i) => (
                  <button
                    type="button"
                    class={`q-wb-tab px-3 py-1.5 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer ${i === 0 ? "q-wb-tab-active" : "bg-white/75 text-dark hover:bg-white"}`}
                    data-wb-tab={i}
                  >
                    {t.tab}
                  </button>
                ))}
              </div>

              <div class="relative rounded-2xl clay-feature-wave p-5 mb-7 border border-white/85 shadow-sm">
                {workbookTabs.map((t, i) => (
                  <div
                    class={`q-wb-panel ${i === 0 ? "block" : "hidden"}`}
                    data-wb-panel={i}
                  >
                    <div class="flex items-center justify-between mb-3 pb-2 border-b border-dark/10">
                      <span class="text-xs font-extrabold uppercase tracking-wider text-primary">
                        {t.tab}
                      </span>
                      <span class="text-xs font-bold text-dark bg-white/80 px-2.5 py-0.5 rounded-full">
                        {t.state}
                      </span>
                    </div>
                    <div class="space-y-2.5">
                      {t.rows.map((r) => (
                        <div class="flex items-center justify-between bg-white/85 px-3.5 py-2 rounded-xl text-xs">
                          <span class="font-semibold text-text-dark">{r.k}</span>
                          <span class="font-bold text-dark">{r.v}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
                <div class="w-full h-1 rounded-full bg-white/50 overflow-hidden mt-3.5">
                  <div
                    class="q-wb-progress h-full rounded-full"
                    style="width: 0%; background: linear-gradient(90deg, #5d8a77, #4c7889);"
                  />
                </div>
              </div>

              <form id="lead-form" novalidate class="">
                <div class="form-control">
                  <input
                    type="text"
                    name="name"
                    placeholder="Company or Name"
                    class="form-input w-full mb-3.5"
                    required
                  />
                  <input
                    type="email"
                    name="email"
                    placeholder="Work Email Address"
                    class="form-input w-full mb-4"
                    required
                  />
                  <button
                    type="submit"
                    id="lead-submit"
                    class="btn btn-primary w-full disabled:opacity-60 disabled:cursor-not-allowed"
                  >
                    <span id="lead-submit-label">{lead_generation.button?.label ?? "Download Sample Workbook"}</span>
                    <span id="lead-submit-loading" class="hidden">Preparing...</span>
                  </button>
                  <div
                    id="lead-form-success"
                    class="hidden mt-4 text-primary font-semibold text-sm text-center"
                  >
                    Sample 5-tab workbook link sent.
                  </div>
                  <div
                    id="lead-form-error"
                    class="hidden mt-4 text-secondary font-semibold text-sm text-center"
                  >
                    <span id="lead-form-error-text">Unable to submit request.</span>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <hr class="h-px bg-linear-to-r from-transparent from-10% via-border to-90% to-transparent border-0" />
</section>

<script>
  const form = document.getElementById("lead-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("lead-submit") as HTMLButtonElement | null;
  const submitLabel = document.getElementById("lead-submit-label");
  const submitLoading = document.getElementById("lead-submit-loading");
  const successEl = document.getElementById("lead-form-success");
  const errorEl = document.getElementById("lead-form-error");

  function setLoading(loading: boolean) {
    if (!submitBtn || !submitLabel || !submitLoading) return;
    submitBtn.disabled = loading;
    submitLabel.classList.toggle("hidden", loading);
    submitLoading.classList.toggle("hidden", !loading);
  }

  function showSuccess() {
    successEl?.classList.remove("hidden");
    errorEl?.classList.add("hidden");
    form?.reset();
  }

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    successEl?.classList.add("hidden");
    errorEl?.classList.add("hidden");
    setLoading(true);
    setTimeout(() => {
      setLoading(false);
      showSuccess();
    }, 400);
  });
</script>
