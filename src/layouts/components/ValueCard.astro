---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  list?: string[];
}
const { logo, title, list } = Astro.props;
---

<div class="p-8 rounded-[26px] clay-card">
  <div class="size-12 rounded-2xl bg-white/75 grid place-items-center mb-6 shadow-sm">
    <ImageMod src={logo} alt={`${title} icon`} class="size-6" />
  </div>
  <h3 class="text-h5-sm font-bold text-dark">{title}</h3>
  <ul class="stars-list mt-5 text-text">
    {list?.map((item) => <li>{item}</li>)}
  </ul>
</div>
