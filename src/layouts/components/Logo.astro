---
import config from "@/config/config.json";
const { title }: { title: string } = config.site;
---

<a
  href="/"
  class="navbar-brand inline-flex items-center gap-3 px-4 py-2 rounded-2xl transition-transform duration-200 hover:-translate-y-0.5"
  style="background: linear-gradient(165deg, #6c9886 0%, #5a8673 55%, #4c7889 100%); border: 1px solid rgba(255, 255, 255, 0.55); box-shadow: 6px 10px 20px rgba(76, 100, 92, 0.25), -3px -3px 10px rgba(255, 255, 255, 0.7), inset 1px 1px 2px rgba(255, 255, 255, 0.35);"
>
  <img
    src="/images/quantum-mark-white-256.png"
    class="inline-block object-contain size-8 shrink-0"
    alt={title}
    width="32"
    height="32"
  />
  <span class="flex flex-col leading-tight text-left">
    <span
      class="text-[16px] font-bold tracking-tight"
      style="color: #ffffff !important;"
    >
      ExciseR.com
    </span>
    <span
      class="whitespace-nowrap text-[11px] font-normal"
      style="color: rgba(255, 255, 255, 0.88) !important;"
    >
      Bringing equilibrium to nuanced taxes
    </span>
  </span>
</a>
